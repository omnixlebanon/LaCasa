{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/POS/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/menu",
      "destination": "/menu/index.html"
    },
    {
      "source": "/menu/",
      "destination": "/menu/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://la-casa-backend.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
