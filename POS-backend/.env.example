PORT=8080
JWT_TOKEN=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:49682
DB_HOST=localhost
DB_USER=root
DB_NAME=POS_DB
DB_PASSWORD=replace-with-database-password
BOT_API_SECRET=replace-with-the-same-secret-used-by-the-telegram-bot

# Set DATABASE_URL to enable PostgreSQL; leave unset to keep using local MySQL.
# Vercel runtime: Supabase transaction pooler URL, port 6543, with TLS verification.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full
APP_TIMEZONE=Asia/Beirut
DB_POOL_SIZE=3
# Optional: the Supabase project's CA certificate PEM (literal \n is supported).
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Migration only: direct or session pooler (5432) URL, never exposed to Vite.
# SUPABASE_MIGRATION_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
